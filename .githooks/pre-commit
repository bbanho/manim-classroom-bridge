#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Pre-commit checks..."

export PYTHONPATH="$(pwd)/src"

# 1. Lint — block only hard errors (E, F, I). Style warnings allowed during bootstrap.
echo "→ ruff check..."
ruff check src/ tests/ --select E,F,I || { echo "❌ ruff failed"; exit 1; }

# 2. Type check
echo "→ mypy..."
mypy --config-file=pyproject.toml --follow-imports=skip --ignore-missing-imports --show-error-codes src/domain src/ports src/usecases src/adapters src/main.py || { echo "❌ mypy failed"; exit 1; }

# 3. Tests
echo "→ pytest..."
PYTHONPATH=src pytest tests/ -q || { echo "❌ tests failed"; exit 1; }

# 4. Docs integrity: verify REQ-* IDs in code match docs
echo "→ docs integrity..."
python3 scripts/verify_requirements.py || { echo "❌ docs integrity failed"; exit 1; }

echo "✅ All checks passed."
