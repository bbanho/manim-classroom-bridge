FROM python:3.11-slim

# Install system dependencies for Manim + LaTeX + ffmpeg
RUN apt-get update && apt-get install -y \
    ffmpeg \
    texlive-full \
    libcairo2 \
    libpango1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Manim CE
RUN pip install --no-cache-dir manim-ce>=0.19

# Create workspace
RUN mkdir -p /workspace/scripts /workspace/output

VOLUME ["/workspace"]

CMD ["tail", "-f", "/dev/null"]  # Keep container alive for docker exec
